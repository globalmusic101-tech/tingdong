{
  "name": "tingdong",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "app:dev": "concurrently \"vite\" \"sleep 2 && ELECTRON_ENABLE_LOGGING=true NODE_ENV=development electron .\"",
    "app:build": "npm run build && electron-packager . Tingdong --platform=darwin --arch=arm64 --overwrite --icon=icon.icns --out=release --ignore=\"^/(src|release|\\\\.appbuild|\\\\.git)($|/)\" --ignore=\"^/(tsconfig.*|eslint\\\\.config\\\\.mjs|vite\\\\.config\\\\.ts|probe.*|.*\\\\.tmp\\\\..*)$\" --ignore=\"^/popup\\\\.html$\"",
    "test": "vitest run"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "msedge-tts": "^2.0.7",
    "pinyin-pro": "^3.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^10.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
